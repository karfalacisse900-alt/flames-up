{
  "name": "FashionPost",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "save_count": {
      "type": "number",
      "default": 0
    },
    "saved_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "image_url",
    "title"
  ]
}