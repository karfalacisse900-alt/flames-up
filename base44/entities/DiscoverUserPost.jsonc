{
  "name": "DiscoverUserPost",
  "type": "object",
  "properties": {
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mix of image and video URLs"
    },
    "media_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "photo or video per item"
    },
    "source_link": {
      "type": "string",
      "description": "URL source"
    },
    "book_name": {
      "type": "string",
      "description": "Book or resource name"
    },
    "source_label": {
      "type": "string",
      "description": "Custom label e.g. YouTube, Podcast, etc."
    },
    "tab": {
      "type": "string",
      "enum": [
        "foryou",
        "culture",
        "science",
        "featured",
        "daily"
      ],
      "default": "foryou"
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comment_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "author_email",
    "body"
  ]
}